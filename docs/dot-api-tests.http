@baseUrl = http://localhost:3000
@bot = XXXX.DUMMY.TOKEN.XXXX

# @name dispatcherLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "dispatcher@dot.test", "password": "Dispatcher123", "turnstileToken": "{{bot}}" }

###
@D = {{dispatcherLogin.response.body.token}}


