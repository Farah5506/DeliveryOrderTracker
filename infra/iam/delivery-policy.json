{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnHistoryTable",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:Query"],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/DotOrderHistory"
    },
    {
      "Sid": "ReadAndAdvanceOrders",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:UpdateItem", "dynamodb:Scan"],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/DotOrders"
    },
    {
      "Sid": "CheckWhoIsLoggedIn",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem"],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/DotSessions",
        "arn:aws:dynamodb:us-east-1:000000000000:table/DotUsers"
      ]
    },
    {
      "Sid": "OwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/dot-delivery-api:*"
    }
  ]
}
